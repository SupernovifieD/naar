# Anthropic skills are fetched from the public GitHub repository:
# https://github.com/anthropics/skills
# No Anthropic API key is required or used.

# Optional GitHub token for higher GitHub API rate limits when fetching
# public GitHub-backed providers such as Anthropic Official Skills and Awesome Agent Skills.
GITHUB_TOKEN=

# Optional ClawHub token for token-auth mode when needed.
CLAWHUB_API_TOKEN=

# Optional provider endpoint overrides.
CLAWHUB_API_BASE_URL=https://clawhub.ai
GITHUB_API_BASE_URL=https://api.github.com

# Optional provider request tuning.
NAAR_PROVIDER_TIMEOUT_MS=10000
NAAR_PROVIDER_RETRY_ATTEMPTS=3
