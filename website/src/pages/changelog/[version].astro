---
import SiteLayout from "../../layouts/SiteLayout.astro";
import Container from "../../components/Container.astro";
import { releases, getReleaseNeighbors } from "../../lib/changelog";
import { withBase } from "../../data/site";

export function getStaticPaths() {
  return releases.map((release) => {
    const neighbors = getReleaseNeighbors(release.slug);
    return {
      params: { version: release.slug },
      props: { release, ...neighbors }
    };
  });
}

const { release, previous, next } = Astro.props;
---
<SiteLayout title={release.slug} description={`Release notes for ${release.slug}.`}>
  <section class="pt-16">
    <Container class="max-w-4xl">
      <a href={withBase("/changelog")} class="text-sm font-medium text-text-soft transition-colors duration-200 ease-glide hover:text-text">← Back to changelog</a>

      <div class="mt-6 glass-panel p-8 sm:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-text-soft">{release.date}</p>
        <h1 class="mt-3 text-4xl font-semibold text-text sm:text-5xl">{release.slug}</h1>
      </div>

      <div class="mt-10 space-y-8">
        {release.sections.map((section) => (
          <section class="glass-panel p-7 sm:p-8">
            <h2 class="text-2xl font-semibold text-text">{section.title}</h2>
            <ul class="mt-5 space-y-3 text-base leading-7 text-text-muted">
              {section.bullets.map((bullet) => (
                <li class="relative pl-6" style={`margin-left: ${bullet.depth * 1.1}rem`}>
                  <span class="absolute left-0 top-3 h-1.5 w-1.5 rounded-full bg-accent-red-soft"></span>
                  {bullet.text}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <div class="mt-10 grid gap-4 sm:grid-cols-2">
        {previous ? (
          <a href={withBase(`/changelog/${previous.slug}`)} class="glass-panel p-6 transition-colors duration-200 ease-glide hover:border-white/20">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-text-soft">Previous release</p>
            <p class="mt-2 text-xl font-semibold text-text">{previous.slug}</p>
            <p class="mt-1 text-sm text-text-muted">{previous.date}</p>
          </a>
        ) : <div />}
        {next ? (
          <a href={withBase(`/changelog/${next.slug}`)} class="glass-panel p-6 text-right transition-colors duration-200 ease-glide hover:border-white/20">
            <p class="text-sm font-semibold uppercase tracking-[0.16em] text-text-soft">Next release</p>
            <p class="mt-2 text-xl font-semibold text-text">{next.slug}</p>
            <p class="mt-1 text-sm text-text-muted">{next.date}</p>
          </a>
        ) : <div />}
      </div>
    </Container>
  </section>
</SiteLayout>
