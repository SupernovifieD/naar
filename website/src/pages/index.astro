---
import { ArrowRight, BadgeCheck, FolderSearch, ShieldCheck, Boxes, Download, Star, LockKeyhole } from "lucide-react";
import SiteLayout from "../layouts/SiteLayout.astro";
import Container from "../components/Container.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Button from "../components/Button.astro";
import TerminalFrame from "../components/TerminalFrame.astro";
import InstallCta from "../components/InstallCta";
import SkillSearchTerminal from "../components/SkillSearchTerminal";
import GoWorkflowTerminal from "../components/GoWorkflowTerminal";
import CommandTypingTerminal from "../components/CommandTypingTerminal";
import HeroPomegranate from "../components/HeroPomegranate";
import { cliVersion, siteMeta, withBase } from "../data/site";
import { releases } from "../data/changelog";

const logoLight = withBase("/assets/naar/naar-logotype-light.png");
const logoMark = withBase("/assets/naar/naar-logo.png");
const latestReleases = releases.slice(0, 2).map((release) => ({
  ...release,
  summaryBullets: release.sections.flatMap((section) =>
    section.bullets
      .filter((bullet) => bullet.depth === 0)
      .slice(0, 2)
      .map((bullet) => bullet.text)
  ).slice(0, 3)
}));

const whyCards = [
  {
    title: "Skills are scattered",
    body: "Useful agent skills live across separate providers and formats. Search should not depend on already knowing where they live.",
    Icon: FolderSearch
  },
  {
    title: "Repo context matters",
    body: "A React app and a Python API should not get the same suggestions. Naar scans the repo before it recommends anything.",
    Icon: Boxes
  },
  {
    title: "Trust should be visible",
    body: "Publisher, license, freshness, and risk belong next to the result. That context should not be buried behind the install step.",
    Icon: BadgeCheck
  },
  {
    title: "Install should be explicit",
    body: "Search stays read-only. Writes happen only after review, security checks, and an install plan you can inspect.",
    Icon: ShieldCheck
  }
];
---
<SiteLayout>
  <section class="relative flex min-h-[calc(100vh-5.25rem)] items-center pt-10 sm:pt-16">
    <Container>
      <div class="mx-auto max-w-5xl text-center">
        <div class="relative isolate overflow-visible rounded-[2rem] px-2 py-10 sm:px-6 sm:py-16">
          <div class="pointer-events-none absolute inset-x-0 top-10 h-48 rounded-full bg-accent-red/12 blur-3xl"></div>
          <div class="pointer-events-none absolute left-1/2 top-1/2 h-64 w-64 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent-orange/10 blur-3xl"></div>
          <div class="pointer-events-none absolute right-[7%] top-8 hidden sm:block lg:right-[9%]">
            <HeroPomegranate client:load src={logoMark} className="relative" />
          </div>

          <div class="relative z-10 flex flex-col items-center gap-7">
            <img src={logoLight} alt="Naar" class="h-14 w-auto sm:h-16 lg:h-20" />
            <div class="space-y-5">
              <h1 class="mx-auto max-w-4xl text-5xl font-semibold tracking-tight text-text sm:text-6xl lg:text-7xl">
                Find the right skills for your AI coding agent.
              </h1>
              <p class="mx-auto max-w-3xl text-lg leading-8 text-text-muted sm:text-xl">
                Naar searches skill providers, understands your repo, and helps you review before anything gets installed.
              </p>
            </div>
            <div class="mx-auto mt-10 w-full max-w-5xl sm:mt-12 lg:mt-14">
              <TerminalFrame title="Terminal" asCode={false} bodyClass="p-0">
                <SkillSearchTerminal client:load dataUrl={withBase("/data/skills-index.json")} />
              </TerminalFrame>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="pt-24">
    <Container>
      <SectionHeader
        eyebrow="Why Naar exists"
        title="A small CLI problem became a bigger trust problem"
        description="Naar is opinionated about discovery, context, and review because the install surface is bigger than a single provider or assistant."
        align="center"
      />
      <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {whyCards.map(({ title, body, Icon }) => (
          <div class="glass-panel p-6">
            <div class="inline-flex rounded-2xl border border-white/10 bg-white/5 p-3 text-accent-gold">
              <Icon size={22} strokeWidth={1.8} />
            </div>
            <h3 class="mt-5 text-xl font-semibold text-text">{title}</h3>
            <p class="mt-3 text-sm leading-7 text-text-muted">{body}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <section class="pt-24">
    <Container>
      <div class="grid gap-10 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
        <div class="space-y-5">
          <SectionHeader
            eyebrow="Guided repo workflow"
            title="Let naar go scan, rank, and stage the install plan"
            description="The guided flow is still the fastest way to see repo-aware recommendations, assistant detection, and a reviewed write plan in one pass."
          >
            <span slot="title">Let <code>naar go</code> scan, rank, and stage the install plan</span>
          </SectionHeader>
          <div class="glass-panel p-6">
            <ul class="space-y-4 text-sm leading-7 text-text-muted">
              <li class="flex gap-3">
                <span class="mt-1 text-accent-gold"><ArrowRight size={16} /></span>
                <span>Scan the repo and infer stack, tools, assistants, and readiness signals.</span>
              </li>
              <li class="flex gap-3">
                <span class="mt-1 text-accent-gold"><ArrowRight size={16} /></span>
                <span>Fetch providers, rank relevant skills, and keep risky or blocked entries explicit.</span>
              </li>
              <li class="flex gap-3">
                <span class="mt-1 text-accent-gold"><ArrowRight size={16} /></span>
                <span>Review selection, inspect writes, and approve the plan before anything lands in the repo.</span>
              </li>
            </ul>
          </div>
        </div>
        <TerminalFrame title="Terminal" asCode={false} bodyClass="p-0">
          <GoWorkflowTerminal client:load version={cliVersion} />
        </TerminalFrame>
      </div>
    </Container>
  </section>

  <section class="pt-24">
    <Container>
      <SectionHeader
        eyebrow="Install, GitHub, security"
        title="Use Naar, inspect the source, and understand the safety model"
        description="The CLI is open-source, install remains explicit, and the security model is documented rather than implied."
        align="center"
      />
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        <div class="glass-panel flex h-full flex-col p-6">
          <div class="inline-flex rounded-2xl border border-white/10 bg-white/5 p-3 text-accent-orange">
            <Download size={22} strokeWidth={1.8} />
          </div>
          <h3 class="mt-5 text-xl font-semibold text-text">Install globally</h3>
          <p class="mt-3 text-sm leading-7 text-text-muted">Install the CLI once, then search directly or use <code>naar go</code> inside any repo.</p>
          <div class="mt-auto pt-5">
            <InstallCta client:load command={siteMeta.installCommand} defaultText={siteMeta.installCommand} copiedText="Copied" revealOnHover={false} className="w-full justify-center" />
          </div>
        </div>
        <div class="glass-panel flex h-full flex-col p-6">
          <div class="inline-flex rounded-2xl border border-white/10 bg-white/5 p-3 text-accent-gold">
            <Star size={22} strokeWidth={1.8} />
          </div>
          <h3 class="mt-5 text-xl font-semibold text-text">Star on GitHub</h3>
          <p class="mt-3 text-sm leading-7 text-text-muted">Inspect the code, follow release work, and keep an eye on target and provider support as it grows.</p>
          <div class="mt-auto pt-5">
            <Button href={siteMeta.githubUrl} target="_blank" rel="noreferrer" class="w-full justify-center" variant="secondary">
              Open repository
            </Button>
          </div>
        </div>
        <div class="glass-panel flex h-full flex-col p-6">
          <div class="inline-flex rounded-2xl border border-white/10 bg-white/5 p-3 text-success">
            <LockKeyhole size={22} strokeWidth={1.8} />
          </div>
          <h3 class="mt-5 text-xl font-semibold text-text">Review the security model</h3>
          <p class="mt-3 text-sm leading-7 text-text-muted">Read how recommendation risk, fetched-bundle analysis, prompts, and explicit overrides work before install.</p>
          <div class="mt-auto pt-5">
            <Button href={withBase("/security")} class="w-full justify-center" variant="secondary">
              Open security guide
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="pt-24">
    <Container>
      <SectionHeader
        eyebrow="Changelog"
        title="Follow the release timeline"
        description="Recent releases focus on direct install clarity, terminal UX, provider retrieval breadth, and safer install workflows."
        align="center"
      />
      <div class="mx-auto mt-12 max-w-4xl space-y-5">
        {latestReleases.map((release, index) => (
          <a
            href={withBase(`/changelog/${release.slug}`)}
            class="group relative block rounded-[1.75rem] border border-white/10 bg-white/[0.03] p-6 transition-[transform,border-color,background-color,box-shadow] duration-300 ease-glide hover:-translate-y-1 hover:border-white/30 hover:bg-white/[0.07] hover:shadow-[0_18px_40px_rgba(0,0,0,0.22)]"
          >
            <span class="absolute right-5 top-5 inline-flex h-3.5 w-3.5 rounded-full border border-white/15 bg-accent-red-soft/90 shadow-[0_0_0_6px_rgba(218,92,98,0.12)] motion-safe:group-hover:animate-[release-dot-pulse_1.15s_ease-in-out_infinite]"></span>
            <div class="grid gap-4 lg:grid-cols-[auto_1fr] lg:gap-6">
              <div class="flex gap-4">
                <div class="flex w-12 flex-col items-center">
                  <span class="inline-flex h-4 w-4 rounded-full border border-white/15 bg-accent-red-soft/90 shadow-[0_0_0_6px_rgba(218,92,98,0.12)]"></span>
                  {index < latestReleases.length - 1 && <span class="mt-3 h-full w-px bg-white/10"></span>}
                </div>
                <div class="space-y-2">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="text-lg font-semibold text-text transition-colors duration-200 ease-glide group-hover:text-white">{release.slug}</span>
                    <span class="text-sm text-text-soft">{release.formattedDate}</span>
                  </div>
                  <ul class="space-y-2 text-sm leading-7 text-text-muted">
                    {release.summaryBullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-8 flex justify-center">
        <Button href={withBase("/changelog")} variant="secondary">
          Show more changelog →
        </Button>
      </div>
    </Container>
  </section>

  <section class="pt-24">
    <Container>
      <div class="glass-panel mx-auto max-w-4xl px-6 py-10 text-center sm:px-10 sm:py-12">
        <div class="space-y-6">
          <h2 class="text-3xl font-semibold text-text sm:text-4xl">
            Better instructions for every repo.<br />
            Full control before every install.
          </h2>
          <div class="mx-auto max-w-2xl">
            <TerminalFrame title="Terminal" asCode={false} bodyClass="p-0">
              <CommandTypingTerminal client:load />
            </TerminalFrame>
          </div>
          <div class="flex flex-col justify-center gap-3 sm:flex-row">
            <InstallCta client:load command={siteMeta.installCommand} defaultText="Install Naar" copiedText="Copied" revealOnHover />
            <Button href={siteMeta.githubUrl} target="_blank" rel="noreferrer" variant="secondary" class="w-full sm:w-auto">
              Star on GitHub
            </Button>
          </div>
        </div>
      </div>
    </Container>
  </section>
</SiteLayout>
