---
import InstallCta from "./InstallCta";
import Container from "./Container.astro";
import { navLinks, siteMeta, withBase } from "../data/site";

const logoDark = withBase("/assets/naar/naar-logotype-light.png");
---
<header class="sticky top-0 z-50 pt-4">
  <Container>
    <div class="gloss-bar flex items-center justify-between rounded-full px-4 py-3 shadow-glow shadow-black/20">
      <a href={withBase("/")} class="flex items-center gap-3" aria-label="Naar home">
        <img src={logoDark} alt="Naar" class="h-7 w-auto" />
      </a>

      <nav class="hidden items-center gap-7 md:flex">
        {navLinks.map((link) => (
          <a href={withBase(link.href)} class="text-sm font-medium text-text-muted transition-colors duration-200 ease-glide hover:text-text">
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden md:block">
        <InstallCta client:load command={siteMeta.installCommand} />
      </div>

      <details class="group md:hidden">
        <summary class="list-none rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm font-medium text-text marker:hidden">
          Menu
        </summary>
        <div class="absolute inset-x-0 top-[calc(100%+0.75rem)] px-6">
          <div class="glass-panel space-y-4 rounded-3xl p-5">
            <nav class="flex flex-col gap-3">
              {navLinks.map((link) => (
                <a href={withBase(link.href)} class="rounded-2xl border border-white/5 bg-white/5 px-4 py-3 text-sm font-medium text-text-muted transition-colors duration-200 ease-glide hover:text-text">
                  {link.label}
                </a>
              ))}
            </nav>
            <InstallCta client:load command={siteMeta.installCommand} />
          </div>
        </div>
      </details>
    </div>
  </Container>
</header>
