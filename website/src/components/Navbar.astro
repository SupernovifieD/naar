---
import InstallCta from "./InstallCta";
import { navLinks, siteMeta, withBase } from "../data/site";

const logoDark = withBase("/assets/naar/naar-logotype-light.png");
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

function isActive(pathname: string): boolean {
  const target = withBase(pathname).replace(/\/$/, "") || "/";
  const homeTarget = withBase("/").replace(/\/$/, "") || "/";
  if (target === homeTarget) {
    return currentPath === homeTarget;
  }
  return currentPath === target || currentPath.startsWith(`${target}/`);
}
---
<header class="sticky top-0 z-50 w-full pt-4">
  <div class="gloss-bar mx-3 rounded-full px-4 py-3 shadow-glow shadow-black/20 sm:mx-6 sm:px-5">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4">
      <a href={withBase("/")} class="flex items-center gap-3" aria-label="Naar home">
        <img src={logoDark} alt="Naar" class="h-8 w-auto sm:h-9 lg:h-10" />
      </a>

      <nav class="hidden items-center gap-2 md:flex" aria-label="Primary navigation">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <a
              href={withBase(link.href)}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-full px-3 py-2 text-sm font-medium transition-colors duration-200 ease-glide",
                active ? "bg-white/10 text-text" : "text-text-muted hover:text-text"
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <div class="hidden shrink-0 md:block">
        <InstallCta client:load command={siteMeta.installCommand} defaultText="Install" revealOnHover />
      </div>

      <details class="group relative md:hidden">
        <summary class="list-none rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm font-medium text-text marker:hidden">
          Menu
        </summary>
        <div class="absolute right-0 top-[calc(100%+0.75rem)] w-[min(22rem,calc(100vw-1.5rem))]">
          <div class="glass-panel space-y-4 rounded-3xl p-5">
            <nav class="flex flex-col gap-3" aria-label="Mobile navigation">
              {navLinks.map((link) => {
                const active = isActive(link.href);
                return (
                  <a
                    href={withBase(link.href)}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "rounded-2xl border px-4 py-3 text-sm font-medium transition-colors duration-200 ease-glide",
                      active
                        ? "border-white/15 bg-white/10 text-text"
                        : "border-white/5 bg-white/5 text-text-muted hover:text-text"
                    ]}
                  >
                    {link.label}
                  </a>
                );
              })}
            </nav>
            <InstallCta client:load command={siteMeta.installCommand} defaultText="Install Naar" revealOnHover={false} className="w-full justify-center" />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>
