{
  "name": "naar-cli",
  "version": "0.1.2",
  "description": "Repo-aware Agent Skill recommender and safe installer",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupernovifieD/naar.git"
  },
  "bugs": {
    "url": "https://github.com/SupernovifieD/naar/issues"
  },
  "homepage": "https://github.com/SupernovifieD/naar#readme",
  "bin": {
    "naar": "dist/cli.js"
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "skills",
    "ai",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@inquirer/prompts": "^7.5.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "jszip": "^3.10.1",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "undici": "^7.11.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
